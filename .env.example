# EliteCore DNS Threat Detection Platform Configuration

# Server Ports
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
DNS_UDP_PORT=53
DNS_DOH_PORT=8443
DNS_DTLS_PORT=853
DTLS_CERT_PATH=certs/server.crt
DTLS_KEY_PATH=certs/server.key

# Upstream DNS Forwarder
UPSTREAM_DNS_PRIMARY=8.8.8.8
UPSTREAM_DNS_SECONDARY=1.1.1.1
DNS_TIMEOUT_SECONDS=2.0

# Security Engine Thresholds
RISK_THRESHOLD_BLOCK=70.0
RISK_THRESHOLD_SUSPICIOUS=40.0

# Data Stores & Paths
SQLITE_DB_PATH=elitecore_telemetry.db
IOC_SNAPSHOT_PATH=threat_intel/ioc_snapshot.json
ML_MODEL_PATH=ml/dga_rf_v1.pkl

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
